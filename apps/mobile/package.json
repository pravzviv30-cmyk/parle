{
  "name": "@parle/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "EXPO_PUBLIC_PARLE_LOCAL_DEVELOPMENT=1 expo start",
    "android": "EXPO_PUBLIC_PARLE_LOCAL_DEVELOPMENT=1 expo start --android",
    "ios": "EXPO_PUBLIC_PARLE_LOCAL_DEVELOPMENT=1 expo start --ios",
    "web": "EXPO_PUBLIC_PARLE_LOCAL_DEVELOPMENT=1 expo start --web",
    "start:device": "EXPO_PUBLIC_PARLE_LOCAL_DEVELOPMENT=1 expo start --dev-client",
    "ios:device": "EXPO_PUBLIC_PARLE_LOCAL_DEVELOPMENT=1 expo run:ios --device",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "EXPO_PUBLIC_PARLE_LOCAL_DEVELOPMENT=1 node --test --experimental-strip-types \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.1.2",
    "@parle/brain": "*",
    "@parle/core": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.11",
    "expo-audio": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.16",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.11",
    "expo-speech": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "livekit-client": "^2.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
