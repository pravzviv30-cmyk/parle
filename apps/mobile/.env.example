# A deployed build requires all three public values below. The Supabase anon
# key is designed for clients; service-role, LiveKit and vendor keys are not.
# Deployed URLs must use HTTPS.
# EXPO_PUBLIC_TOKEN_SERVER_URL=https://api.luvani.example
# EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=<public Apple SDK key>
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=<public Google SDK key>
# EXPO_PUBLIC_REVENUECAT_STARTER_PRODUCT_ID=luvani_starter_monthly

# `npm run web`, `npm run ios`, `npm run android` and tests inject the explicit
# local-development flag and may use mock accounts plus localhost services.
# Never set this in a store or hosted build.
# EXPO_PUBLIC_LUVANI_LOCAL_DEVELOPMENT=1

# Testing on a PHYSICAL iPhone: the phone cannot reach the Mac's localhost, so
# point the app at the Mac's LAN IP (find it with `ipconfig getifaddr en0`). The
# run scripts already inject the local-development flag, so plain HTTP is allowed:
#   EXPO_PUBLIC_TOKEN_SERVER_URL=http://192.168.1.23:8787
# The iOS Simulator needs none of this — it shares the Mac's localhost.
