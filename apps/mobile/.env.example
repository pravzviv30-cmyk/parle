# A deployed build requires all three public values below. The Supabase anon
# key is designed for clients; service-role, LiveKit and vendor keys are not.
# Deployed URLs must use HTTPS.
# EXPO_PUBLIC_TOKEN_SERVER_URL=https://api.parle.example
# EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# `npm run web`, `npm run ios`, `npm run android` and tests inject the explicit
# local-development flag and may use mock accounts plus localhost services.
# Never set this in a store or hosted build.
# EXPO_PUBLIC_PARLE_LOCAL_DEVELOPMENT=1
