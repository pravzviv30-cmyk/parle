# All optional. With none of these set, the app runs keyless: demo speech
# pipeline, on-device demo accounts, localhost token server.

# Where the token server lives (default http://localhost:8787).
# EXPO_PUBLIC_TOKEN_SERVER_URL=http://localhost:8787

# Supabase project — both set = real accounts (email/password + Google).
# Neither set = on-device demo account store.
# EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>
