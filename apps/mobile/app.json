{
  "expo": {
    "name": "Luvani",
    "slug": "luvani",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/luvani-app-icon-1024.png",
    "scheme": "luvani",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "deploymentTarget": "16.4",
      "bundleIdentifier": "com.luvani.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Luvani uses your microphone for spoken French conversations and practice recordings you choose to make.",
        "EXDevMenuShowFloatingActionButton": false
      }
    },
    "android": {
      "package": "com.luvani.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF6E9",
        "foregroundImage": "./assets/brand/luvani-adaptive-foreground-1024.png",
        "monochromeImage": "./assets/brand/luvani-adaptive-monochrome-1024.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/luvani-app-icon-1024.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "@livekit/react-native-expo-plugin",
      "expo-sharing",
      "expo-audio",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      "@config-plugins/react-native-webrtc",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6E9",
          "image": "./assets/brand/luvani-mark-1024.png",
          "imageWidth": 200
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "19183dc7-05cc-459a-b95f-6d7ad6fd6665"
      }
    },
    "owner": "praveen30",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/19183dc7-05cc-459a-b95f-6d7ad6fd6665",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
