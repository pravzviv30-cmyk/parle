{
  "expo": {
    "name": "Luvani",
    "slug": "luvani",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/luvani-app-icon-1024.png",
    "scheme": "luvani",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "deploymentTarget": "16.4",
      "bundleIdentifier": "com.luvani.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Luvani listens while you speak French so it can tell you which sounds to work on."
      }
    },
    "android": {
      "package": "com.luvani.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF6E9",
        "foregroundImage": "./assets/brand/luvani-adaptive-foreground-1024.png",
        "monochromeImage": "./assets/brand/luvani-adaptive-monochrome-1024.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/luvani-app-icon-1024.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "@livekit/react-native-expo-plugin",
      "expo-sharing",
      "expo-audio",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      "@config-plugins/react-native-webrtc",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6E9",
          "image": "./assets/brand/luvani-mark-1024.png",
          "imageWidth": 200
        }
      ],
      "expo-notifications"
    ]
  }
}
