# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# ...except the legal pages. src/legal/dist/ is generated by `npm run legal:html`
# and committed on purpose: the founder uploads that folder to Cloudflare by
# hand, and legal/html.test.ts fails when what is committed no longer matches
# the module, which is the whole check against the hosted page drifting from the
# screen. A file nobody can commit cannot be compared against.
!src/legal/dist/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
