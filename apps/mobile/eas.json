{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "node": "24.16.0",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_LUVANI_LOCAL_DEVELOPMENT": "1",
        "EXPO_PUBLIC_LUVANI_BUILD_PROFILE": "development"
      },
      "channel": "development"
    },
    "staging": {
      "node": "24.16.0",
      "environment": "preview",
      "developmentClient": false,
      "distribution": "internal",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_LUVANI_LOCAL_DEVELOPMENT": "0",
        "EXPO_PUBLIC_LUVANI_WALL_PREVIEW": "0",
        "EXPO_PUBLIC_LUVANI_BUILD_PROFILE": "staging"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "node": "24.16.0",
      "environment": "production",
      "developmentClient": false,
      "distribution": "store",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_LUVANI_LOCAL_DEVELOPMENT": "0",
        "EXPO_PUBLIC_LUVANI_WALL_PREVIEW": "0",
        "EXPO_PUBLIC_LUVANI_BUILD_PROFILE": "production"
      },
      "channel": "production"
    }
  }
}
