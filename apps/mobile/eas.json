{
  "cli": { "appVersionSource": "local" },
  "build": {
    "development": {
      "node": "24.16.0",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_LUVANI_LOCAL_DEVELOPMENT": "1" }
    },
    "staging": {
      "node": "24.16.0",
      "environment": "preview",
      "developmentClient": false,
      "distribution": "internal",
      "autoIncrement": false,
      "env": { "EXPO_PUBLIC_LUVANI_LOCAL_DEVELOPMENT": "0", "EXPO_PUBLIC_LUVANI_WALL_PREVIEW": "0" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "node": "24.16.0",
      "environment": "production",
      "developmentClient": false,
      "distribution": "store",
      "autoIncrement": false,
      "env": { "EXPO_PUBLIC_LUVANI_LOCAL_DEVELOPMENT": "0", "EXPO_PUBLIC_LUVANI_WALL_PREVIEW": "0" }
    }
  }
}
