{
  "name": "parle",
  "private": true,
  "version": "0.1.0",
  "description": "Speak French from your first session — and know exactly which sounds you're getting wrong.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "node --experimental-strip-types scripts/dev.mjs",
    "web": "npm run web --workspace=@parle/mobile",
    "gate": "node scripts/gate.mjs",
    "gate:bless": "node scripts/gate.mjs --bless",
    "loop": "node scripts/loop.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
