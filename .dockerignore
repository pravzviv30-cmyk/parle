# Allowlist prevents local secrets/research/backups from entering a build context.
**
!package.json
!package-lock.json
!Dockerfile
!.dockerignore
!packages/
!packages/core/
!packages/core/**
!packages/brain/
!packages/brain/**
!services/
!services/shared/
!services/shared/**
!services/token-server/
!services/token-server/package.json
!services/token-server/src/
!services/token-server/src/**
!services/tutor-agent/
!services/tutor-agent/package.json
!services/tutor-agent/src/
!services/tutor-agent/src/**
!services/brain-playground/
!services/brain-playground/package.json
!apps/
!apps/mobile/
!apps/mobile/package.json
!scripts/
!scripts/installHooks.mjs
!scripts/patchExpoModulesJsi.mjs
!deployment/
!deployment/entrypoint.sh
!deployment/validateBuild.mjs
!deployment/nativeArtifacts.mjs
!deployment/validateEnvironment.mjs
!deployment/environment-contract.json
!deployment/verifyAudioDecoder.mjs
!deployment/observability.mjs
# Exclusions after the allowlist always win, including nested local state.
.git
**/.git
**/node_modules
**/.env*
**/*.test.*
**/verify/
**/fixtures/
**/*.pem
**/*.key
**/*.p12
**/*.p8
**/credentials*.json
**/.tts-cache
**/dist
**/build
**/*.log
