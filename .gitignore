node_modules/
dist/
build/
.expo/
.expo-shared/
web-build/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Secrets — never commit
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store
*.pem

# Native build output
ios/
android/
!apps/mobile/ios/.gitkeep
!apps/mobile/android/.gitkeep

# Synthesized tutor audio (regenerate with: npm run warm-cache -w @parle/tutor-agent)
.tts-cache/

# graphify — the graph itself IS committed (graph.json, GRAPH_REPORT.md,
# graph.html, manifest.json) so a clone starts with the map. These are the
# local-only parts: absolute interpreter paths and per-machine run state.
graphify-out/cost.json
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_ast.json
graphify-out/.graphify_detect.json
graphify-out/.graphify_incremental.json
graphify-out/.graphify_old.json
graphify-out/.graphify_uncached.txt
graphify-out/.graphify_labels.json.sig
# dated pre-update backups of the curated graph
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# The bug loop keeps its journal here — per-run, per-machine, never committed.
.loop/

# /forge keeps each pass's contract and round log here. Same deal: per-run state,
# not a document. The ledger in docs/KNOWN_ISSUES.md is the part that persists.
.forge/
