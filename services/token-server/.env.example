# LiveKit — required. Self-hosted dev server values or your LiveKit Cloud keys.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-livekit-local-0000000000

# PORT=8787

# Speechace — optional; without it drill scoring falls back to self-report.
# SPEECHACE_API_KEY=

# Supabase token verification — optional. With neither set, the server trusts
# the client-asserted userId (keyless dev). Set ONE of these to require and
# verify Supabase access tokens on /session/start and /drill/score:
# SUPABASE_URL=https://<project>.supabase.co        (new projects: JWKS)
# SUPABASE_JWT_SECRET=<legacy JWT secret>           (legacy projects: HS256)

# Shared with the tutor agent. /session/end has no learner token in its path —
# the agent is the caller — so without this anything that can reach the port can
# debit any account by name. Unset locally, required anywhere else.
# PARLE_AGENT_SECRET=

# Where metered balances live. Unset, they live in memory and a restart hands
# every learner their minutes back.
# ENTITLEMENT_STORE_PATH=./.entitlements.json

# Local testing only. Gives every test account a fresh Regular allowance on
# every request and never debits it. Ignored when NODE_ENV=production.
# PARLE_DEV_UNLIMITED_MINUTES=1
