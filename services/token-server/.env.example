# LiveKit — required. Self-hosted dev server values or your LiveKit Cloud keys.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-livekit-local-0000000000

# PORT=8787

# Speechace — optional; without it drill scoring falls back to self-report.
# SPEECHACE_API_KEY=

# Supabase token verification — optional. With neither set, the server trusts
# the client-asserted userId (keyless dev). Set ONE of these to require and
# verify Supabase access tokens on /session/start and /drill/score:
# SUPABASE_URL=https://<project>.supabase.co        (new projects: JWKS)
# SUPABASE_JWT_SECRET=<legacy JWT secret>           (legacy projects: HS256)
