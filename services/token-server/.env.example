# LiveKit — required. Self-hosted dev server values or your LiveKit Cloud keys.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-livekit-local-0000000000

# PORT=8787

# Unsafe local fallbacks are disabled unless the local dev script injects this.
# Never set it in a deployed service; `npm start` pins NODE_ENV=production.
# PARLE_LOCAL_DEVELOPMENT=1

# Exact comma-separated browser origins. Required in production; native apps
# do not send Origin. Wildcards and HTTP production origins are refused.
# PARLE_ALLOWED_ORIGINS=https://app.parle.example,https://beta.parle.example

# Shared request budgets. Production refuses to boot without both Upstash
# values and a deployment-unique salt. The salt hashes user, installation and
# IP signals before they become Redis keys.
# UPSTASH_REDIS_REST_URL=https://<database>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<server-only token>
# PARLE_RATE_LIMIT_SALT=<at least 32 random characters>
# Set only behind a trusted reverse proxy that overwrites X-Forwarded-For.
# PARLE_TRUST_PROXY=1

# Speechace — optional; without it drill scoring falls back to self-report.
# SPEECHACE_API_KEY=

# Supabase is required in production. SUPABASE_URL selects asymmetric JWKS
# verification; a legacy HS256 secret is only a local compatibility fallback
# when no project URL is configured.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=<local/legacy JWT secret>
# SUPABASE_SERVICE_ROLE_KEY=<server-only service role key>
# The service-role key enables durable entitlements, privacy-filtered product
# events and account deletion. Never expose it through an EXPO_PUBLIC variable.

# Shared with the tutor agent. Required outside explicit local development.
# PARLE_AGENT_SECRET=

# Local development fallback only. Production refuses file and memory stores
# because they cannot provide atomic, multi-instance debits.
# ENTITLEMENT_STORE_PATH=./.entitlements.json

# Local testing only. Gives every test account a fresh Regular allowance on
# every request and never debits it. Ignored when NODE_ENV=production.
# PARLE_DEV_UNLIMITED_MINUTES=1
