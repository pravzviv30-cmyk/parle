# LiveKit — required. Self-hosted dev server values or your LiveKit Cloud keys.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-livekit-local-0000000000

# PORT=8787

# Optional spoken own-words transcription, using the existing speech recipient.
# Server only. Missing or refused keys leave typed judgment available.
# DEEPGRAM_API_KEY=

# Unsafe local fallbacks are disabled unless the local dev script injects this.
# Never set it in a deployed service; `npm start` pins NODE_ENV=production.
# LUVANI_LOCAL_DEVELOPMENT=1

# Exact comma-separated browser origins. Required in production; native apps
# do not send Origin. Wildcards and HTTP production origins are refused.
# LUVANI_ALLOWED_ORIGINS=https://app.luvani.example,https://beta.luvani.example

# Shared request budgets. Production refuses to boot without both Upstash
# values and a deployment-unique salt. The salt hashes user, installation and
# IP signals before they become Redis keys.
# UPSTASH_REDIS_REST_URL=https://<database>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<server-only token>
# LUVANI_RATE_LIMIT_SALT=<at least 32 random characters>
# Set only behind a trusted reverse proxy that overwrites X-Forwarded-For.
# LUVANI_TRUST_PROXY=1

# Pronunciation scoring for drills and sound checks (POST /drill/score).
# Optional; without a key, drill scoring falls back to honest self-report.
# TonePerfect is the default whenever its key is set and Speechace is the
# alternative; services/shared/pronunciation.ts makes the choice. Server-side
# only. TonePerfect bills a credit per 15 s of audio and says it deletes the
# audio after scoring and keeps the assessment for at most 24 hours.
# TONEPERFECT_API_KEY=
# SPEECHACE_API_KEY=
# toneperfect or speechace. Unset picks by which key is set; a vendor named
# without its key scores nothing rather than sending audio to the other one.
# LUVANI_SCORING_VENDOR=toneperfect
# LUVANI_AUDIO_SCORING is the tutor agent's live-session switch. This server
# does not read it: it scores every /drill/score request it is sent.

# TypeSafe Jev — optional. Reads each own-words drill attempt before the
# language model does; a clean pass (meaning kept, understood, natural French)
# is settled by Jev alone and skips the model call. Everything else still goes
# to the language model, so this adds to TUTOR_LLM's key rather than replacing
# it. Server-side only. It sends the learner's typed attempt to TypeSafe, so
# the privacy policy has to name TypeSafe before this is set in production.
# TYPESAFE_API_KEY=<server-only TypeSafe key>
# TYPESAFE_MODEL=jev-1.13.0

# Supabase is required in production. SUPABASE_URL selects asymmetric JWKS
# verification; a legacy HS256 secret is only a local compatibility fallback
# when no project URL is configured.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=<local/legacy JWT secret>
# SUPABASE_SERVICE_ROLE_KEY=<server-only service role key>
# The service-role key enables durable entitlements, privacy-filtered product
# events and account deletion. Never expose it through an EXPO_PUBLIC variable.

# Shared with the tutor agent. Required outside explicit local development.
# LUVANI_AGENT_SECRET=

# Enable only after the three 20260920 practice migrations are applied.
# Run the separate supervised practice-worker with the same Supabase credentials.
# LUVANI_DURABLE_PRACTICE=1
# Required for API practice-answer judging and the separate recovery worker:
# TUTOR_LLM=openai
# OPENAI_API_KEY=<server-only provider key>

# Local development fallback only. Production refuses file and memory stores
# because they cannot provide atomic, multi-instance debits.
# ENTITLEMENT_STORE_PATH=./.entitlements.json

# Local testing only. Gives every test account a fresh Regular allowance on
# every request and never debits it. Ignored when NODE_ENV=production.
# LUVANI_DEV_UNLIMITED_MINUTES=1

# RevenueCat is optional until store products exist. Leave all five unset to
# keep purchases dark; production refuses a partial set.
# REVENUECAT_SECRET_API_KEY=<server-only v1 secret key>
# Also required for account deletion: request queued subscriber erasure before
# removing the Luvani identity. Never use a public SDK key for this operation.
# LUVANI_REVENUECAT_WEBHOOK_SECRET=<exact Authorization header configured in RevenueCat>
# REVENUECAT_ENTITLEMENT_ID=luvani
# REVENUECAT_STARTER_PRODUCT_ID=luvani_starter_monthly
# REVENUECAT_REGULAR_PRODUCT_ID=luvani_regular_monthly

# Pair the public mobile entitlement/product ids with these server ids. Native
# purchase operations check /billing/readiness before opening the store; apply
# 20261002154637_atomic_billing_projection.sql before enabling billing.

# Explicit typing-only recovery: set to 1 in BOTH agent and token-server envs.
# Spoken session starts are refused; brain and LiveKit credentials remain required.
LUVANI_TYPED_ONLY=0
# Explicit saved-phrase Hear; dark unless BOTH this switch and the DB policy
# are enabled, approved USD caps installed, and actual account/voice billing
# upper bounds verified per fingerprint (expires within 30 days). No defaults.
LUVANI_PHRASE_AUDIO_GENERATION=0
# Optional server-only ElevenLabs credential for this route. Never EXPO_PUBLIC.
# ELEVEN_API_KEY=

# Correction-only Jev shortcut stays off; reviewed real-French calibration is
# additionally required. Key presence or setting 1 alone cannot activate it.
LUVANI_FIX_LINE_JEV=0
