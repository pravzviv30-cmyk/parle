# Copy to .env and fill in. Never commit the filled version.

# ─── LiveKit transport ────────────────────────────────────────────────────────
# Free self-hosted path: run `livekit-server --dev` (open source, Apache 2.0) and
# use its built-in dev credentials. Localhost only — never expose devkey/secret.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Paid path: a LiveKit Cloud project (wss://your-project.livekit.cloud) + its keys.

# ─── The tutor brain ──────────────────────────────────────────────────────────
# groq  → Llama 3.3 70B on Groq's free tier (console.groq.com, no card). $0.
# anthropic → Claude, the production brain. Needs ANTHROPIC_API_KEY.
TUTOR_LLM=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Which model on Groq. Leave unset for the current default. Groq retires models
# without warning and answers a request for a retired one with a bare 404, which
# reaches a learner as a tutor that joins and never speaks — so if the tutor goes
# silent, check this first against https://console.groq.com/docs/models.
# GROQ_MODEL=

# ─── Speech to text ───────────────────────────────────────────────────────────
# The hardest part of this pipeline. Learner French is mangled French, and a
# transcriber that silently "corrects" it destroys the pronunciation signal.
# Measure word error rate on real beginner audio before trusting this.
DEEPGRAM_API_KEY=

# ─── French voice ─────────────────────────────────────────────────────────────
# The dominant cost line (~$0.045/min of speech). If margins bite, the first
# move is premium voice for conversation and a cheaper voice for repeated drills.
ELEVEN_API_KEY=
# A native French voice. Pick one deliberately — for a beginner this is the most
# immediately felt quality signal in the whole product.
ELEVEN_VOICE_ID=

# ─── Pronunciation assessment ─────────────────────────────────────────────────
# Optional. Without it the session still runs and simply reports no pronunciation
# focus, rather than inventing one.
SPEECHACE_API_KEY=

# ─── Talking to the token server ──────────────────────────────────────────────
# Must match PARLE_AGENT_SECRET in services/token-server/.env. Without it the
# debit endpoint is open to anyone who can reach it.
# PARLE_AGENT_SECRET=

# ─── Pronunciation scoring ────────────────────────────────────────────────────
# Set to 1 to send captured learner audio to Speechace during live sessions.
# Off by default: the capture is tested, but the vendor's phone alphabet is not
# verified against a live response yet, and a mismatch fails quietly to "no
# focus". With this unset the end card honestly reports that nothing was scored.
# PARLE_AUDIO_SCORING=1
# SPEECHACE_API_KEY=
