# Which model powers the brain.
#   openai     GPT-5.6 Luna live + Terra analyst. Needs OPENAI_API_KEY.
#   anthropic  Claude routed by activity. Needs ANTHROPIC_API_KEY.
#   groq       Current Groq free-tier model. $0, weaker coaching. Needs GROQ_API_KEY.
#   mock       Offline scripted turns, for demos and tests. No key.
# Unset, the playground picks the best it has a key for.
BRAIN_LLM=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional: low | medium | high. Lower is faster and cheaper per turn. Default high.
BRAIN_EFFORT=
