{
  "name": "@luvani/brain-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal playground for talking to the tutor brain, plus the curated live eval.",
  "type": "module",
  "scripts": {
    "chat": "node --experimental-strip-types src/chat.ts",
    "eval": "node --experimental-strip-types src/eval/runEval.ts",
    "eval:frames": "node --experimental-strip-types src/eval/frameEval.ts",
    "eval:drills": "node --experimental-strip-types src/eval/drillEval.ts",
    "eval:curation": "node --experimental-strip-types src/eval/curationEval.ts",
    "eval:sessions": "node --experimental-strip-types src/eval/sessionEval.ts",
    "eval:replay": "node --experimental-strip-types src/eval/replayEval.ts",
    "eval:beta-numbers": "node --experimental-strip-types src/eval/betaNumbers.ts",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@luvani/brain": "*",
    "@luvani/core": "*",
    "@luvani/tutor-agent": "*",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
